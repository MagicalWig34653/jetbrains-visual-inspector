<idea-plugin>
    <id>io.github.magicalwig34653.visualinspector</id>
    <name>Visual Inspector</name>
    <vendor url="https://github.com/MagicalWig34653/jetbrains-visual-inspector">Visual Inspector contributors</vendor>
    <description><![CDATA[
        <p>Bidirectional navigation between rendered web pages and their source code for WebStorm and PhpStorm.</p>
        <p><b>Early development:</b> this version only contains the project scaffold. Preview and inspector features are not implemented yet.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Visual Inspector"
                    anchor="right"
                    factoryClass="io.github.magicalwig34653.visualinspector.toolwindow.InspectorToolWindowFactory"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Visual Inspector" displayType="BALLOON"/>
    </extensions>

    <actions>
        <group id="VisualInspector.Group" text="Visual Inspector" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="VisualInspector.OpenInInspector"
                    class="io.github.magicalwig34653.visualinspector.action.OpenInInspectorAction"
                    text="Open Current HTML File in Visual Inspector"/>
            <action id="VisualInspector.HighlightInPreview"
                    class="io.github.magicalwig34653.visualinspector.action.HighlightInPreviewAction"
                    text="Highlight in Visual Inspector Preview"/>
            <action id="VisualInspector.NextInstance"
                    class="io.github.magicalwig34653.visualinspector.action.NextInstanceAction"
                    text="Next Instance in Visual Inspector Preview"/>
        </group>
    </actions>

    <extensions defaultExtensionNs="org.jetbrains">
        <webServerFileHandler
                implementation="io.github.magicalwig34653.visualinspector.server.LocationInjectingFileHandler"
                order="first"/>
    </extensions>
</idea-plugin>
